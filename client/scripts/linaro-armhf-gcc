#!/bin/sh
# arm-linux-gnueabihf-gcc / g++ wrapper for the Linux CI target.
#
# MuPDF 1.27's bundled HarfBuzz does not compile with Linaro gcc 4.9
# (__builtin_mul_overflow, C++ templates). Ubuntu's armhf gcc 13 can compile
# it. The objects still have to link the Linaro sysroot: that libc is glibc
# 2.19, which is what the Kobo rootfs provides. Ubuntu's own armhf headers
# are glibc 2.39 and must not be on the include path, or the two trees
# disagree (time64, __locale_t) and the link asks for symbols Kobo lacks.
#
# Install as both names:
#   arm-linux-gnueabihf-gcc
#   arm-linux-gnueabihf-g++
# The basename selects the driver. ar/nm/ranlib stay the real binutils.
set -eu

base=$(basename "$0")
case "$base" in
    *-g++|*-c++) driver=g++ ;;
    *) driver=gcc ;;
esac

linaro=/opt/gcc-linaro-4.9.4-2017.01-x86_64_arm-linux-gnueabihf
sysroot=$linaro/arm-linux-gnueabihf/libc
real=/usr/bin/arm-linux-gnueabihf-$driver
gcc_inc=/usr/lib/gcc-cross/arm-linux-gnueabihf/13/include

if [ ! -x "$real" ]; then
    echo "$real is not installed (apt install gcc-arm-linux-gnueabihf g++-arm-linux-gnueabihf)" >&2
    exit 1
fi
if [ ! -f "$sysroot/usr/include/stdio.h" ]; then
    echo "Linaro sysroot is missing: $sysroot" >&2
    exit 1
fi

# -B selects the Linaro crt objects. Ubuntu's Scrt1.o pulls GLIBC_2.34.
# -L selects the Linaro libstdc++. Ubuntu's needs GLIBC_2.38.
if [ "$driver" = g++ ]; then
    cxx=/usr/arm-linux-gnueabihf/include/c++/13
    # shellcheck disable=SC2086
    exec "$real" --sysroot="$sysroot" -nostdinc \
        -isystem "$gcc_inc" \
        -isystem "$cxx" \
        -isystem "$cxx/arm-linux-gnueabihf" \
        -isystem "$sysroot/usr/include" \
        -B"$sysroot/usr/lib/" \
        -B"$sysroot/lib/" \
        -L"$linaro/arm-linux-gnueabihf/lib" \
        -static-libgcc \
        -U_TIME_BITS \
        -D_GLIBCXX_USE_C99_MATH=0 \
        "$@"
fi

exec "$real" --sysroot="$sysroot" -nostdinc \
    -isystem "$gcc_inc" \
    -isystem "$sysroot/usr/include" \
    -B"$sysroot/usr/lib/" \
    -B"$sysroot/lib/" \
    -L"$linaro/arm-linux-gnueabihf/lib" \
    -static-libgcc \
    -U_TIME_BITS \
    "$@"
